# Volcengine credentials (do not commit real values)
VOLC_APP_KEY=
VOLC_ACCESS_KEY=
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# Optional boosting table containing Reachy/瑞奇/瑞琪/瑞吉 with weights 8/8/6/6.
VOLC_BOOSTING_TABLE_ID=

# Suppress transcripts until a wake keyword opens a renewable 30-second window.
KEYWORD_GATE_ENABLED=true
# Optional. Comma-separated prefix-only wake words (Chinese comma also OK).
# Defaults to: 语音,微信,一起,云溪,微启,允许,机器,运气
# VOLC_GATE_PREFIX_WORDS=语音,微信,一起,云溪,微启,允许,机器,运气

# Alternative to the three credential variables above:
# HA_CONFIG_ENTRIES=/config/.storage/core.config_entries

ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8765
ADAPTER_PATH=/v1/realtime
AUDIO_SAMPLE_RATE=16000
VOLC_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

# Full Conversation proxy. "allocator" requests a fresh Hugging Face Realtime
# session for each Reachy connection; "direct" uses UPSTREAM_REALTIME_URL.
UPSTREAM_MODE=allocator
UPSTREAM_SESSION_URL=https://pollen-robotics-reachy-mini-realtime-url.hf.space/session
UPSTREAM_REALTIME_URL=
# Optional. Anonymous allocation works on the current Reachy service; set this
# only if the allocator requires an authenticated Hugging Face account.
HF_TOKEN=
REACHY_DAEMON_URL=http://192.168.31.94:8000
UPSTREAM_OPEN_TIMEOUT_SECONDS=20
