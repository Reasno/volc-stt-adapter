# Volcengine credentials (do not commit real values)
VOLC_APP_KEY=
VOLC_ACCESS_KEY=
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_BOOSTING_TABLE_ID=

# KWS v2: off (bypass), shadow (observe only, default), enforce (block).
KWS_MODE=shadow
# KWS backend runtime: openwakeword (default, ONNX) or microwakeword (tflite).
# The microwakeword backend requires tflite-runtime (or ai-edge-litert) and
# pymicro-features on the target device; see README for aarch64 wheel setup.
KWS_RUNTIME=openwakeword
# Native path: ./models/... ; Docker path: /app/models/...
# For KWS_RUNTIME=microwakeword point this at the wake-word .tflite file
# (e.g. /opt/volc-stt-adapter/models/reachy.tflite).
KWS_MODEL_PATH=./models/reechy-spk150-steps100k-acc98.15-rec97.50.onnx
KWS_THRESHOLD=0.5
KWS_PREROLL_SECONDS=1.5
KWS_TRIGGER_TIMEOUT_SECONDS=3
KWS_SPEAKER_WINDOW_SECONDS=30
KWS_MATCH_TOLERANCE_MS=400
KWS_QUEUE_FRAMES=32
# microwakeword tuning (only used when KWS_RUNTIME=microwakeword).
# When enabling, also set KWS_THRESHOLD to the desired probability cutoff
# (default 0.95) — the detector compares the smoothed score against
# KWS_THRESHOLD, matching microWakeWord/ESPHome semantics.
KWS_MICROWAKEWORD_SLIDING_WINDOW=5
KWS_MICROWAKEWORD_STEP_MS=40
# Optional: override the wakeword name reported by the microwakeword backend
# (defaults to the tflite file stem).
KWS_WAKEWORD_NAME=

# Post-stream text gate: once the KWS opens the Volcengine stream, per-utterance
# admission is decided by the ASR transcript, not by the KWS/AudioGate. Any
# speaker who says one of the built-in wake keywords (reachy/瑞奇/...) or one
# of these prefix-only wake words below at the *head* of their utterance opens
# a 30s window; subsequent utterances from the same speaker refresh the window.
# The Volcengine stream is soft-closed as soon as no speaker window is still
# active (with a 30s initial grace after wake). Empty VOLC_GATE_PREFIX_WORDS
# falls back to the built-in default.
KEYWORD_GATE_ENABLED=true
VOLC_GATE_PREFIX_WORDS=

# Alternative to the three credential variables above:
# HA_CONFIG_ENTRIES=/config/.storage/core.config_entries
ADAPTER_HOST=0.0.0.0
ADAPTER_PORT=8765
ADAPTER_PATH=/v1/realtime
AUDIO_SAMPLE_RATE=16000
VOLC_TIMEOUT_SECONDS=30
LOG_LEVEL=INFO

UPSTREAM_MODE=allocator
UPSTREAM_SESSION_URL=https://pollen-robotics-reachy-mini-realtime-url.hf.space/session
UPSTREAM_REALTIME_URL=
HF_TOKEN=
REACHY_DAEMON_URL=http://192.168.31.94:8000
UPSTREAM_OPEN_TIMEOUT_SECONDS=20

# Active speech HTTP API
SPEAK_HTTP_HOST=0.0.0.0
SPEAK_HTTP_PORT=8766
SPEAK_TOTAL_TIMEOUT_SECONDS=45
REACHY_CONVERSATION_RPC_URL=ws://192.168.31.94:7860/rpc
VOLC_TTS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts
VOLC_TTS_TIMEOUT_SECONDS=30
VOLC_TTS_MAX_AUDIO_BYTES=16777216
# Process-local fallback audio LRU entries; 0 disables caching.
VOLC_TTS_CACHE_ENTRIES=100
# Directory for the persistent TTS audio cache (survives restarts).
# For docker-compose mount ./data:/app/data so the cache is durable.
VOLC_TTS_CACHE_DIR=./data/tts_cache
DAEMON_SOUND_TIMEOUT_SECONDS=10
DAEMON_SOUND_CLEANUP_DELAY_SECONDS=300
