# Reachy Mini 原生 systemd 配置。部署后填写 /etc/volc-stt-adapter/adapter.env。
# 必填秘密：由部署时提供，禁止提交真实值。
VOLC_APP_KEY=
VOLC_ACCESS_KEY=

# 火山 STT/ASR
VOLC_RESOURCE_ID=volc.seedasr.sauc.duration
VOLC_ASR_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLC_TIMEOUT_SECONDS=30
VOLC_BOOSTING_TABLE_ID=
AUDIO_SAMPLE_RATE=16000

# Adapter STT 仅供本机 Reachy daemon 使用。
ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8765
ADAPTER_PATH=/v1/realtime
LOG_LEVEL=INFO

# Reachy KWS：systemd 部署必须使用绝对模型路径。
KWS_MODE=enforce
KWS_MODEL_PATH=/opt/volc-stt-adapter/models/reechy-spk150-steps100k-acc98.15-rec97.50.onnx
KWS_THRESHOLD=0.5
KWS_PREROLL_SECONDS=1.5
KWS_TRIGGER_TIMEOUT_SECONDS=3
KWS_SPEAKER_WINDOW_SECONDS=30
KWS_MATCH_TOLERANCE_MS=400
KWS_QUEUE_FRAMES=32

# 也可改用 HA 配置项文件提供火山凭据（通常不用于本机原生部署）。
# HA_CONFIG_ENTRIES=/config/.storage/core.config_entries

# 既有 Hugging Face Realtime allocator 上游。
UPSTREAM_MODE=allocator
UPSTREAM_REALTIME_URL=
UPSTREAM_SESSION_URL=https://pollen-robotics-reachy-mini-realtime-url.hf.space/session
# 可选 allocator 凭据，由部署时提供；公开 allocator 可留空。
HF_TOKEN=
UPSTREAM_OPEN_TIMEOUT_SECONDS=20

# /speak 对可信 LAN 提供服务；conversation 与 daemon 均走 localhost。
SPEAK_HTTP_HOST=0.0.0.0
SPEAK_HTTP_PORT=8766
SPEAK_TOTAL_TIMEOUT_SECONDS=45
REACHY_CONVERSATION_RPC_URL=ws://127.0.0.1:7860/rpc
REACHY_DAEMON_URL=http://127.0.0.1:8000

# Seed-TTS fallback（复用上面的 VOLC_APP_KEY/VOLC_ACCESS_KEY）。
VOLC_TTS_URL=wss://openspeech.bytedance.com/api/v3/tts/bidirection
VOLC_TTS_RESOURCE_ID=seed-tts-2.0
VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts
VOLC_TTS_TIMEOUT_SECONDS=30
VOLC_TTS_MAX_AUDIO_BYTES=16777216
# 进程内 fallback 音频 LRU 条目数；0 表示禁用。
VOLC_TTS_CACHE_ENTRIES=100
# Directory for the persistent TTS audio cache (survives restarts).
# scripts/install-systemd.sh creates this dir and chowns it to volc-stt.
VOLC_TTS_CACHE_DIR=/var/cache/volc-stt-adapter/tts
DAEMON_SOUND_TIMEOUT_SECONDS=10
DAEMON_SOUND_CLEANUP_DELAY_SECONDS=300
